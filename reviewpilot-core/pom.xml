<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.nephets</groupId>
    <artifactId>reviewpilot</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>reviewpilot-core</artifactId>
  <name>reviewpilot-core</name>
  <description>纯 Java（零 Spring）引擎层：DAG 工作流引擎、阶段执行器、内存运行存储、阶段注册表，以及 FetchDiff/StaticAnalysis/Aggregate/Report 等内置阶段执行器。仅依赖 JDK 21、slf4j 与 reviewpilot-contract / reviewpilot-llm。</description>

  <!--
    ★ 本模块严禁引入任何 org.springframework.* 依赖。
      CI 的 architecture-boundaries job 用 grep 扫描编译期源码，出现 org.springframework.* 即失败。
  -->
  <dependencies>
    <dependency>
      <groupId>io.github.nephets</groupId>
      <artifactId>reviewpilot-contract</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.nephets</groupId>
      <artifactId>reviewpilot-llm</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>**/package-info.java</exclude>
          </excludes>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <properties>
    <jacoco.line.minimum>${jacoco.line.minimum.core}</jacoco.line.minimum>
    <jacoco.report.skip>false</jacoco.report.skip>
  </properties>
</project>
